        ]
      }
    },
    "/api/bookings": {
      "get": {
        "operationId": "app_presentation_api_get_bookings",
        "summary": "List bookings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "Bookings"
        ]
      },
      "post": {
        "operationId": "app_presentation_api_post_booking",
        "summary": "Create a booking",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "Takes one copy of the book. 409 if no copies are available.",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingInput"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/bookings/{booking_id}": {
      "get": {
        "operationId": "app_presentation_api_get_booking",
        "summary": "Get a booking",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDetailsOutput"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Bookings"
        ]
      },
      "patch": {
        "operationId": "app_presentation_api_patch_booking",
        "summary": "Update a booking",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "Only active bookings can be changed (409 otherwise). Moving a booking to another book returns the old copy and takes one from the new book (409 if none is available).",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookingInput"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "operationId": "app_presentation_api_delete_booking",
        "summary": "Cancel a booking",
        "parameters": [
          {
            "in": "path",
            "name": "booking_id",
            "schema": {
              "title": "Booking Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "Soft delete: status becomes `cancelled` and the copy becomes available again. Repeating the call is harmless. 409 for a returned booking.",
        "tags": [
          "Bookings"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "description": "A stored book. Copy-count rules live here, so every use case shares them.\n\nThe methods never mutate: they return a changed copy (the caller then saves it).",
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "isbn": {
            "title": "Isbn",
            "type": "string"
          },
          "copies_total": {
            "minimum": 0,
            "title": "Copies Total",
            "type": "integer"
          },
          "copies_available": {
            "minimum": 0,
            "title": "Copies Available",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "title",
          "author",
          "isbn",
          "copies_total",
          "copies_available",
          "id"
        ],
        "title": "Book",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "CreateBookInput": {
        "description": "Register copies of a book.\n\nIf a book with the same ISBN, title and author already exists, ``copies_total``\nis the number of copies ADDED to it (and to its available copies).",
        "properties": {
          "title": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "author": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Author",
            "type": "string"
          },
          "isbn": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Isbn",
            "type": "string"
          },
          "copies_total": {
            "minimum": 1,
            "title": "Copies Total",
            "type": "integer"
          }
        },
        "required": [
          "title",
          "author",
          "isbn",
          "copies_total"
        ],
        "title": "CreateBookInput",
        "type": "object"
      },
      "UpdateBookInput": {
        "description": "All fields optional: PATCH only changes what the client sends.\n\n``copies_total`` is the NEW total stock (not an increment). Copies currently on\nloan stay on loan, so ``copies_available`` is recomputed.",
        "properties": {
          "title": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "author": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "isbn": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isbn"
          },
          "copies_total": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Copies Total"
          }
        },
        "title": "UpdateBookInput",
        "type": "object"
      },
      "Reader": {
        "properties": {
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "full_name",
          "email",
          "id"
        ],
        "title": "Reader",
        "type": "object"
      },
      "CreateReaderInput": {
        "properties": {
          "full_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email"
        ],
        "title": "CreateReaderInput",
        "type": "object"
      },
      "ReaderNameOutput": {
        "properties": {
          "full_name": {
            "title": "Full Name",
            "type": "string"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "ReaderNameOutput",
        "type": "object"
      },
      "UpdateReaderInput": {
        "properties": {
          "full_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "title": "UpdateReaderInput",
        "type": "object"
      },
      "Booking": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "integer"
          },
          "reader_id": {
            "title": "Reader Id",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BookingStatus"
              }
            ],
            "default": "active"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "book_id",
          "reader_id",
          "start_date",
          "end_date",
          "id"
        ],
        "title": "Booking",
        "type": "object"
      },
      "BookingStatus": {
        "enum": [
          "active",
          "returned",
          "cancelled"
        ],
        "title": "BookingStatus",
        "type": "string"
      },
      "CreateBookingInput": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "integer"
          },
          "reader_id": {
            "title": "Reader Id",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          }
        },
        "required": [
          "book_id",
          "reader_id",
          "start_date",
          "end_date"
        ],
        "title": "CreateBookingInput",
        "type": "object"
      },
      "BookingDetailsOutput": {
        "properties": {
          "book_id": {
            "title": "Book Id",
            "type": "integer"
          },
          "reader_id": {
            "title": "Reader Id",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          }
        },
        "required": [
          "book_id",
          "reader_id",
          "start_date",
          "end_date",
          "status"
        ],
        "title": "BookingDetailsOutput",
        "type": "object"
      },
      "UpdateBookingInput": {
        "properties": {
          "book_id": {
            "anyOf": [
              {
                "type": "integer"
              },
