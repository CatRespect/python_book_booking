{
  "openapi": "3.1.0",
  "info": {
    "title": "Book Booking API",
    "version": "0.3.0",
    "description": "Full CRUD backed by PostgreSQL, with copy availability tracking. Booking takes a copy; cancelling returns it; re-adding a book with the same ISBN, title and author adds copies."
  },
  "paths": {
    "/api/books": {
      "get": {
        "operationId": "app_presentation_api_get_books",
        "summary": "List books",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "Books"
        ]
      },
      "post": {
        "operationId": "app_presentation_api_post_book",
        "summary": "Create a book, or add copies to an existing one",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "201: a new book was created. 200: a book with the same ISBN, title and author already existed, so `copies_total` copies were added to its total and available counts. 409: the ISBN exists with a different title or author.",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookInput"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/books/{book_id}": {
      "get": {
        "operationId": "app_presentation_api_get_book",
        "summary": "Get a book",
        "parameters": [
          {
            "in": "path",
            "name": "book_id",
            "schema": {
              "title": "Book Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Books"
        ]
      },
      "patch": {
        "operationId": "app_presentation_api_patch_book",
        "summary": "Update a book",
        "parameters": [
          {
            "in": "path",
            "name": "book_id",
            "schema": {
              "title": "Book Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "`copies_total` is the new total stock; copies on loan are kept, so `copies_available` is recomputed. 409 if it would drop below the copies on loan, or if the new ISBN belongs to another book.",
        "tags": [
          "Books"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBookInput"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "operationId": "app_presentation_api_delete_book",
        "summary": "Delete a book",
        "parameters": [
          {
            "in": "path",
            "name": "book_id",
            "schema": {
              "title": "Book Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "description": "409 if the book has any bookings (including cancelled ones).",
        "tags": [
          "Books"
        ]
      }
    },
